# Copy to .env next to this file and fill in. Never commit .env.
# API keys do NOT go here: they are entered as credentials in the n8n editor,
# where n8n stores them encrypted with N8N_ENCRYPTION_KEY.

# Public address of n8n
N8N_HOST=automation.pulauskas.dev
N8N_PROTOCOL=https
N8N_PORT=5678
WEBHOOK_URL=https://automation.pulauskas.dev/
N8N_EDITOR_BASE_URL=https://automation.pulauskas.dev/
# One reverse proxy (Caddy) in front: trust its X-Forwarded-For
N8N_PROXY_HOPS=1

# Encrypts the stored credentials. Generate once: openssl rand -hex 32
# Keep a copy in your password manager: without it the credentials cannot be read.
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=Europe/Vilnius
TZ=Europe/Vilnius

# Privacy: keep execution data (form submissions) for 14 days only
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false

# Docker network of the Caddy container (docker network ls)
PROXY_NETWORK=
